# Django Production / Local Environment Variables Example

# Secret key (generate a random secure string in production)
DJANGO_SECRET_KEY=django-insecure-your-production-secret-key-here

# Debug mode: False for production, True for local development
DJANGO_DEBUG=False

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=127.0.0.1,localhost,your-render-service.onrender.com

# Database URL (Provided automatically by Render if connecting a PostgreSQL database)
# If not provided, Django smoothly defaults to local SQLite (db.sqlite3)
# DATABASE_URL=postgresql://user:password@host:port/database

# CORS Allowed Origins for Vercel Frontend (comma-separated)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# CORS Allow All Origins (True allows any origin, recommended to be False in strict production)
CORS_ALLOW_ALL_ORIGINS=False

# CSRF Trusted Origins (comma-separated)
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app
